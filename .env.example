# =============================================================
# Copy this file to .env and fill in your values.
# cp .env.example .env
# =============================================================

# ─────────────────────────────────────────────────────────────
# Providers — where issues live, and where MRs/PRs + CI live
# ─────────────────────────────────────────────────────────────
QA_TRACKER=gitlab          # gitlab | github | jira | azure-devops
QA_CODE_HOST=gitlab        # gitlab | github | azure-devops | bitbucket
# Fill in only the sections for the providers you picked.

# GitLab (token: plugin settings, or .mcp.json / GITLAB_TOKEN when working from a clone)
GITLAB_TOKEN=your_gitlab_personal_access_token
GITLAB_PROJECT_ID=your-project-id          # "42" or "your-group%2Fyour-project"
GITLAB_URL=https://gitlab.com

# GitHub (auth: `gh auth login`, or GH_TOKEN for CI)
GITHUB_REPO=owner/repo

# Jira (or connect an Atlassian MCP server instead of the token)
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_PROJECT_KEY=SHOP
JIRA_EMAIL=
JIRA_API_TOKEN=

# Azure DevOps (az CLI + azure-devops extension)
AZDO_ORG_URL=https://dev.azure.com/your-org
AZDO_PROJECT=
AZDO_REPO=
AZURE_DEVOPS_EXT_PAT=

# Bitbucket Cloud (code host; pair with Jira for issues)
BITBUCKET_WORKSPACE=
BITBUCKET_REPO=
BITBUCKET_EMAIL=
BITBUCKET_API_TOKEN=

# ─────────────────────────────────────────────────────────────
# Environments
# ─────────────────────────────────────────────────────────────
STAGING_URL=https://staging.myapp.com
PROD_URL=https://myapp.com
FEATURE_BASE_URL=https://feature.myapp.com

# ─────────────────────────────────────────────────────────────
# API Testing
# ─────────────────────────────────────────────────────────────
# Auth token used for API test cases (placeholder — not a real credential)
API_TEST_TOKEN=test-bearer-token-here
# Optional second test account, for WAY 17 cross-user ownership workflows
API_TEST_TOKEN_B=
# E2E API (WAY 17 with several specs): one base URL per service, token optional (else API_TEST_TOKEN)
# ORDERS_BASE_URL=https://orders.staging.myapp.com
# ORDERS_TOKEN=
# API response time threshold in ms (default: 2000)
API_PERF_THRESHOLD_MS=2000

# ─────────────────────────────────────────────────────────────
# Competitor Benchmark (WAY 7)
# ─────────────────────────────────────────────────────────────
# Optional — only needed to clone PRIVATE GitHub repos as a benchmark target
# (private GitLab repos reuse GITLAB_TOKEN). Read-only scope is enough.
GITHUB_TOKEN=

# ─────────────────────────────────────────────────────────────
# Artifacts — local storage paths (no need to change)
# ─────────────────────────────────────────────────────────────
SCREENSHOT_DIR=./qa-artifacts/screenshots
API_RESPONSE_DIR=./qa-artifacts/api-responses
SESSION_DIR=./qa-artifacts/sessions
CI_REPORT_DIR=./qa-artifacts/ci
BENCHMARK_DIR=./qa-artifacts/benchmarks
# Accessibility results no longer have their own folder — they're part of each
# scenario's test-execution-agent output (test-writer bakes an axe-core step
# into every UI scenario instead of running a separate pass)
